{
  "name": "forgeswarm-local",
  "services": {
    "db": {
      "image": "postgres:17.11-bookworm@sha256:66aafa11cf15800a3c94763f7e11d1e7b2e37e5e84bc4ce027cb6e1e4bfaf4df",
      "platform": "linux/amd64",
      "environment": {
        "POSTGRES_USER": "forgeswarm",
        "POSTGRES_DB": "forgeswarm",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password"
      },
      "entrypoint": [
        "sh",
        "-ec",
        "umask 077; cp /run/secrets/db_key /tmp/server.key; chown postgres:postgres /tmp/server.key; exec docker-entrypoint.sh postgres -c ssl=on -c ssl_min_protocol_version=TLSv1.3 -c ssl_cert_file=/run/secrets/db_cert -c ssl_key_file=/tmp/server.key -c hba_file=/etc/postgresql/pg_hba.conf -c max_connections=64 -c shared_buffers=64MB"
      ],
      "secrets": [
        "db_password",
        "db_key",
        "db_cert"
      ],
      "volumes": [
        "state:/var/lib/postgresql/data",
        "./pg_hba.conf:/etc/postgresql/pg_hba.conf:ro"
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,size=16777216"
      ],
      "mem_limit": "384m",
      "cpus": 1,
      "pids_limit": 96,
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "forgeswarm",
          "-d",
          "forgeswarm"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 30
      }
    },
    "broker": {
      "image": "nats:2.11.6-alpine@sha256:7dec3f8f1ff181975dbdfc0d903d2a9724659648294dbc2ebb2fa3a294d573a6",
      "platform": "linux/amd64",
      "entrypoint": [
        "sh",
        "-ec",
        "export NATS_TOKEN=$$(cat /run/secrets/nats_token); exec nats-server -c /etc/nats/secure.conf"
      ],
      "secrets": [
        "nats_token",
        "broker_cert",
        "broker_key"
      ],
      "volumes": [
        "${ASSETS_DIR}/nats.conf:/etc/nats/secure.conf:ro",
        "messages:/data"
      ],
      "networks": [
        "default",
        "execution"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "128m",
      "cpus": 0.25,
      "pids_limit": 64,
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "-",
          "http://127.0.0.1:8222/healthz"
        ],
        "interval": "3s",
        "timeout": "2s",
        "retries": 30
      }
    },
    "migrate": {
      "image": "${PLATFORM_IMAGE:?prepare the trusted local image}",
      "platform": "linux/amd64",
      "pull_policy": "never",
      "init": true,
      "read_only": true,
      "user": "10002:10002",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "192m",
      "cpus": 0.5,
      "pids_limit": 64,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=16777216"
      ],
      "stop_grace_period": "30s",
      "networks": [
        "default"
      ],
      "profiles": [
        "local"
      ],
      "command": [
        "migrate",
        "up"
      ],
      "environment": {
        "GOMAXPROCS": "2",
        "DATABASE_URL_FILE": "/run/secrets/database_url",
        "DB_MAX_CONNS": "6",
        "RPC_ADDR": "coordinator:9090",
        "RPC_TLS_CA": "/run/secrets/ca",
        "NATS_URL": "tls://broker:4222",
        "NATS_TLS_CA": "/run/secrets/ca",
        "INSECURE_LOCAL": "false",
        "TOTAL_CAPACITY": "2",
        "WORKER_MAX_CAPACITY": "1",
        "WORKER_CAPACITY": "1",
        "ATTEMPT_LEASE": "6s",
        "WORKER_FRESHNESS": "10s",
        "RPC_TIMEOUT": "2s",
        "SCHEDULER_INTERVAL": "100ms",
        "SCHEDULER_SCAN_TIMEOUT": "2s",
        "MAX_WORKFLOWS": "32",
        "MAX_TASKS_PER_WORKFLOW": "16",
        "MAX_QUEUED_TASKS": "128",
        "MAX_READY_TASKS": "8",
        "TASK_MAX_ATTEMPTS": "3",
        "AGENT_ENABLED": "false",
        "AGENT_CATALOG": "/assets/catalog",
        "AGENT_PRICING_FILE": "/app/agent-pricing.json",
        "COLLAB_ENABLED": "true",
        "SANDBOX_FIXTURE_REGISTRY": "/assets/fixtures",
        "TELEMETRY_ENABLED": "false",
        "TELEMETRY_DOCKER_LOCAL": "true",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "collector:4317",
        "TELEMETRY_SAMPLE_RATIO": "0.25"
      },
      "secrets": [
        "database_url",
        "ca"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      }

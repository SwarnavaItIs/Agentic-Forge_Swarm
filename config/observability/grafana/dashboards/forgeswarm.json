  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Admission / ready / claim p95",
      "description": "24h durable projections. Empty populations are omitted.",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeswarm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "forgeswarm_recorded_duration_quantile_seconds{quantile=\"p95\",measurement=~\"admission_to_ready|ready_to_claim\"}",
          "legendFormat": "{{state}}{{measurement}}{{operation}}{{outcome}}{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },

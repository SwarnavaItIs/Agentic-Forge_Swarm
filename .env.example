# Development only; these are public local defaults, not production credentials.
DATABASE_URL=postgres://forgeswarm:forgeswarm_dev@127.0.0.1:54329/forgeswarm?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
REQUEST_TIMEOUT=5s
READY_TIMEOUT=1s
CONNECT_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
READ_HEADER_TIMEOUT=2s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
DB_MAX_CONNS=10
DB_MIN_CONNS=0

SCHEDULER_BATCH_SIZE=16
SCHEDULER_INTERVAL=1s
SCHEDULER_SCAN_TIMEOUT=5s

# Required for distributed processes, supplied by the operator; no real secrets.
RPC_ADDR=127.0.0.1:9090
RPC_KEYS_FILE=.cache/worker-credentials.json
WORKER_TOKEN=
NATS_URL=tls://127.0.0.1:4222
NATS_TOKEN=
RPC_TLS_CERT=
RPC_TLS_KEY=
RPC_TLS_CA=
NATS_TLS_CA=
INSECURE_LOCAL=false
WORKER_CAPACITY=2
WORKER_MAX_CAPACITY=2
TOTAL_CAPACITY=4
ATTEMPT_LEASE=3s
RPC_TIMEOUT=1s
RELAY_LEASE=5s
RELAY_BATCH=10
DISPATCH_POLL=100ms

# Same recovery/admission settings on all API/coordinator/scheduler instances.
MAX_WORKFLOWS=100
MAX_TASKS_PER_WORKFLOW=100
MAX_QUEUED_TASKS=10000
MAX_READY_TASKS=1000
TASK_MAX_ATTEMPTS=3
WORKFLOW_TIMEOUT=10m
TASK_TIMEOUT=2m
RETRY_BACKOFF_BASE=250ms
RETRY_BACKOFF_CAP=5s
READY_RESEND_INTERVAL=5s
CAPABILITY_WAIT=30s
WORKER_FRESHNESS=5s

# Trusted Linux-engine fixture execution. Prepare the image explicitly with
# make sandbox-prepare. Keep one stable installation UUID for restart cleanup.
# The worker needs Docker access; repository containers never receive it.
SANDBOX_ENABLED=false
SANDBOX_INSTALLATION_ID=
SANDBOX_FIXTURE_REGISTRY=.cache/sandbox-fixtures
SANDBOX_HELPER=bin/sandbox-helper-linux

# Stage 06 stays disabled until the operator configures the local confined
# runtime and catalog. These settings never authorize a paid provider call.
AGENT_ENABLED=false
AGENT_CATALOG=.cache/agent-catalog
AGENT_PRICING_FILE=config/agent-pricing.json
AGENT_RUNTIME_ADDR=127.0.0.1:9091
AGENT_RUNTIME_TOKEN=
AGENT_INSECURE_LOCAL=false
# Runtime-only settings; never forward worker/DB/broker credentials to Python.
AGENT_PROVIDER=disabled
AGENT_TEST_DEMO=false
AGENT_LIVE_ENABLED=false

# Stage 07 local operator surface; migrate first and upgrade all roles together.
COLLAB_ENABLED=false
COLLAB_MAX_ROUNDS=2
# Build web/ explicitly. When configured, API hosting requires local loopback.
WEB_DIR=

# Stage 08: auth protects every /v1 read/control/artifact route when configured.
# Generate ignored credentials: go run ./cmd/operator-init -file .cache/operator-auth.json
# Loopback only; nonlocal hosting is refused (no unauthenticated public controls).
OPERATOR_AUTH_FILE=
# Trusted API and publisher only. Never pass this file/token into workers/runtime.
# Copy config/github.example.json under .cache; use one least-privilege repository
# installation token or explicit development fine-grained token: metadata/issues
# read, contents/pull requests write. No administration/actions/deployment access.
# Installation-token refresh is operator-managed; 401 stops publication.
GITHUB_CONFIG_FILE=
# Scheduler-only; pinned into each request using the database clock.
APPROVAL_TTL=24h
